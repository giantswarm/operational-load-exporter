{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "cortex": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "password": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "externalDNSIP": {
            "type": "string"
        },
        "gcpProject": {
            "type": "string"
        },
        "github": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "app": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "id": {
                            "type": [
                                "string",
                                "integer"
                            ],
                            "description": "The App ID. Accepts a string or a number."
                        },
                        "installationID": {
                            "type": [
                                "string",
                                "integer"
                            ],
                            "description": "The installation ID of the App on the giantswarm organization. Accepts a string or a number."
                        },
                        "privateKey": {
                            "type": "string",
                            "description": "The App private key, PEM text (not base64; the chart encodes it)."
                        }
                    }
                },
                "key": {
                    "type": "string",
                    "description": "Legacy personal access token (already base64, written straight into the Secret's `data:`). Used only when the GitHub App values below are not all set."
                }
            }
        },
        "global": {
            "type": [
                "object",
                "null"
            ],
            "description": "Global values shared between all subcharts and the platform.",
            "additionalProperties": true,
            "properties": {
                "podSecurityStandards": {
                    "type": "object",
                    "additionalProperties": true
                }
            }
        },
        "helm": {
            "type": "object",
            "additionalProperties": true
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string"
                },
                "registry": {
                    "type": "string"
                },
                "tag": {
                    "type": "string"
                }
            }
        },
        "incidentio": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "key": {
                    "type": "string"
                }
            }
        },
        "managementCluster": {
            "type": "string"
        },
        "provider": {
            "type": "string"
        },
        "resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "grafanaAgent": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "limits": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "main": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "limits": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "subscriptionID": {
            "type": "string"
        }
    }
}
